{
    "name": "rawphp/laravel-capabilities",
    "description": "Product capability bus for Laravel — define once, expose via agent, MCP, HTTP, CLI, and jobs",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "capabilities",
        "agents",
        "mcp",
        "ai"
    ],
    "authors": [
        {
            "name": "rawphp"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/bus": "^11.0|^12.0|^13.0",
        "illuminate/events": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/validation": "^11.0|^12.0|^13.0"
    },
    "conflict": {
        "laravel/prompts": "<0.1.15"
    },
    "suggest": {
        "laravel/ai": "Required when surfaces.agent is enabled",
        "laravel/mcp": "Required when surfaces.mcp is enabled",
        "rawphp/laravel-capabilities-messaging": "Conversation surfaces (Telegram, …)"
    },
    "autoload": {
        "psr-4": {
            "Rawphp\\Capabilities\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.x-dev"
        },
        "laravel": {
            "providers": [
                "Rawphp\\Capabilities\\CapabilitiesServiceProvider"
            ],
            "aliases": {
                "Capability": "Rawphp\\Capabilities\\Facades\\Capability"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
