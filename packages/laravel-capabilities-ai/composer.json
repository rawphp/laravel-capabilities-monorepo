{
    "name": "rawphp/laravel-capabilities-ai",
    "description": "Conversation / turn / proposal runtime for the Laravel Capabilities bus \u2014 pluggable LlmClient, progress store, bus-only tools",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "capabilities",
        "ai",
        "llm",
        "agents"
    ],
    "authors": [
        {
            "name": "rawphp"
        }
    ],
    "require": {
        "php": "^8.2",
        "rawphp/laravel-capabilities": "*",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Rawphp\\CapabilitiesAi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rawphp\\CapabilitiesAi\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.x-dev"
        },
        "laravel": {
            "providers": [
                "Rawphp\\CapabilitiesAi\\CapabilitiesAiServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest --configuration=phpunit.xml --colors=always"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
