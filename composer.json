{
    "name": "rawphp/laravel-capabilities-monorepo",
    "description": "Monorepo for rawphp/laravel-capabilities, messaging + AI siblings, and product CLI",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "rawphp/laravel-capabilities": "*@dev",
        "rawphp/laravel-capabilities-messaging": "*@dev",
        "rawphp/laravel-capabilities-ai": "*@dev"
    },
    "require-dev": {
        "laravel/pint": "^1.30",
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Rawphp\\Capabilities\\": "packages/laravel-capabilities/src/",
            "Rawphp\\CapabilitiesMessaging\\": "packages/laravel-capabilities-messaging/src/",
            "Rawphp\\CapabilitiesAi\\": "packages/laravel-capabilities-ai/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rawphp\\Capabilities\\Tests\\": "packages/laravel-capabilities/tests/",
            "Rawphp\\CapabilitiesMessaging\\Tests\\": "packages/laravel-capabilities-messaging/tests/",
            "Rawphp\\CapabilitiesAi\\Tests\\": "packages/laravel-capabilities-ai/tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/laravel-capabilities",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "packages/laravel-capabilities-messaging",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "packages/laravel-capabilities-ai",
            "options": {
                "symlink": true
            }
        }
    ],
    "scripts": {
        "format": "pint --config=pint.json packages/laravel-capabilities packages/laravel-capabilities-messaging packages/laravel-capabilities-ai",
        "format:test": "pint --test --config=pint.json packages/laravel-capabilities packages/laravel-capabilities-messaging packages/laravel-capabilities-ai",
        "test": [
            "@test:core",
            "@test:messaging",
            "@test:ai"
        ],
        "test:core": "pest --configuration=packages/laravel-capabilities/phpunit.xml --colors=always",
        "test:messaging": "pest --configuration=packages/laravel-capabilities-messaging/phpunit.xml --colors=always",
        "test:cli": "cd packages/capabilities-cli && go test ./...",
        "test:ai": "pest --configuration=packages/laravel-capabilities-ai/phpunit.xml --colors=always"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
